+      levels:
+          - basic
+          - intermediate
+          - advanced
+      status: automated
+      rules:
+          - file_groupowner_grub2_cfg
+          - file_groupowner_user_cfg
+          - file_owner_grub2_cfg
+          - file_owner_user_cfg
+          - file_permissions_grub2_cfg
+          - file_permissions_user_cfg
+
